# Copy to sdkconfig.secrets (gitignored) and fill in. Applied on top of sdkconfig.defaults.
# After changing a value here, delete sdkconfig (and build_rev1/sdkconfig) and build again:
# defaults only fill in settings that sdkconfig doesn't already have.
CONFIG_PL_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_PL_WIFI_PASS="YOUR_WIFI_PASSWORD"
CONFIG_PL_AP_PASS="pianolog-setup"
CONFIG_PL_OTA_TOKEN="CHANGE-ME-ota-token"
